# Copy to .env.development / .env.production as needed (both are gitignored except the
# committed .env.example / .env.production templates already in this repo).
#
# VITE_API_URL is baked into the bundle at build time and runs in the user's browser — see
# .env.production for the full explanation of why it must be a relative path (no localhost,
# no leading /api) once deployed.
#
# Local dev default: the backend runs on localhost:8080 (see back/aulas/.env.example).
VITE_API_URL=http://localhost:8080

# VITE_ROUTER_BASENAME sets BrowserRouter's basename (see src/main.jsx) — only needed when the
# app is served under a subpath. Not needed in dev; see .env.production for the subpath example.
# VITE_ROUTER_BASENAME=/~aulas_icf
