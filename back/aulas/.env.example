# =============================================================================
# Environment configuration template — Aulas ICF backend
# =============================================================================
# Copy this file to `.env` in this same directory (back/aulas/.env) and fill in real values.
# `.env` is gitignored — never commit it. Spring Boot loads it natively via
# `spring.config.import`, declared ONLY in application-dev.properties. This file is for
# LOCAL DEVELOPMENT ONLY — production configuration comes exclusively from the process
# environment (systemd EnvironmentFile), never from a .env file. See README.md.
#
# CRITICAL: never add SPRING_PROFILES_ACTIVE to this file. Declaring a profile from a
# config source imported via spring.config.import conflicts with the profile Spring Boot
# is already resolving and breaks startup. Choose the profile via a real OS environment
# variable or `--spring.profiles.active`, never from here.
#
# FORMAT RULE: this file is also meant to be usable as a systemd EnvironmentFile in production.
# Neither Spring's .properties parser nor systemd's EnvironmentFile parser support inline
# comments — a `#` in the middle of a line does NOT start a comment, it becomes part of the
# value (e.g. `JWT_SECRET=xxx # 32 chars` would assign the literal string "xxx # 32 chars").
# Keep all comments on their own line, and do not wrap values in quotes.
# =============================================================================

# ── Required in production (no default — startup fails without them) ──────────────────

# Datasource.
# In production, pin serverTimezone if the DB/OS runs in UTC (affects audit Timestamp
# columns; reservation dates use LocalDate and are timezone-agnostic). Example for prod:
# DB_URL=jdbc:mysql://localhost:3306/aulas_icf?serverTimezone=America/Mexico_City&useUnicode=true&characterEncoding=UTF-8
DB_URL=jdbc:mysql://localhost:3306/test_aulas
DB_USERNAME=root
DB_PASSWORD=changeme

# JWT signing secret. Generate a long random value (>= 32 chars), unique per environment.
# Never reuse the dev default across environments.
JWT_SECRET=changeme-generate-a-long-random-secret

# CORS allowed origin(s), comma-separated. Must be scheme + host + port ONLY — never a path.
# OK:    https://www.fis.unam.mx
# WRONG: https://www.fis.unam.mx/salasicf
# NOTE: the correct variable name is APP_CORS_ALLOWED_ORIGINS — an older revision of this
# file used ALLOWED_ORIGINS, which no property in application.properties ever read.
APP_CORS_ALLOWED_ORIGINS=http://localhost:4173

# Frontend base URL, used to build links in password-reset emails. May include a subpath.
APP_FRONTEND_URL=http://localhost:5173

# SMTP mail configuration.
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=changeme
MAIL_PASSWORD=changeme

# Mailbox that receives admin notifications (CC recipients are added on top of it).
APP_NOTIFICATIONS_SUPER_ADMIN_EMAIL=admin@icf.unam.mx

# Root directory for server-side file storage (student rosters, etc.).
# In production, use an ABSOLUTE persistent path — a relative path like ./data depends on the
# process's current working directory, which is fragile under systemd/service managers.
# Example for prod: STORAGE_BASE_DIR=/var/lib/aulas-icf/uploads
STORAGE_BASE_DIR=./data

# ── Optional (safe defaults already applied in application.properties) ────────────────

MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# Rate limiting (RateLimitFilter) on sensitive auth endpoints.
APP_RATE_LIMIT_CAPACITY=5
APP_RATE_LIMIT_WINDOW_MINUTES=1
# Set to true ONLY when deployed behind a trusted reverse proxy (Apache2, nginx, ALB, etc.).
# Enables trusting X-Forwarded-For for real-IP resolution; false = use the raw socket address.
# Defaults to false in dev, true in prod (application-prod.properties) — only override here
# if this specific environment needs to diverge from its profile's default.
APP_TRUST_PROXY=false

# Bootstrap admin seeder (see AdminSeeder.java / R__reference_data.sql).
# Set both to create the first ADMIN user when starting against a clean database.
# The password must be at least 12 characters or AdminSeeder aborts startup.
# SECURITY: remove or blank these two lines immediately after the first successful login.
# Leaving them set means any future run against an empty `users` table re-creates this admin
# with this password (e.g. an accidental wipe, or a test run pointed at prod by mistake).
APP_SEED_ADMIN_PASSWORD=
APP_SEED_ADMIN_EMAIL=
# Explicit kill switch: set to false to start up without provisioning any admin at all
# (e.g. mid-restore from a backup that already has one). Defaults to true.
APP_SEED_ADMIN_ENABLED=true
